# Copy to .env and fill with real values. NEVER commit a filled .env.
# All values below are placeholders only.

# Neon Postgres (GNC Ground project) — the full connection string goes into DATABASE_URL below at deploy time
DATABASE_URL=postgresql://user:password@localhost:5432/gnc_prime

# Own auth (JWT) — secret used to sign login tokens (Build Step 3)
JWT_SECRET=<redacted>

# Google sign-in (optional) — OAuth client id; set the web app's VITE_GOOGLE_CLIENT_ID to the same value. Leave empty to disable Google sign-in (the API returns 501 on /api/auth/google)
GOOGLE_CLIENT_ID=your-google-client-id-placeholder

# Owner account — this email is exempt from the daily free message cap
OWNER_EMAIL=you@example.com

# Google AI Studio — separate project for Ground, so quota is not shared with Prohori
GEMINI_GROUND_API_KEY=your-gemini-ground-api-key-placeholder

# OpenCode Zen — free models gateway
OPENCODE_API_KEY=your-opencode-api-key-placeholder

# Limits / server
DAILY_MSG_CAP=20
PORT=4000
# Chat answers also stream over SSE via POST /api/chat/stream (no extra config).

# Dev only: set to 1 to accept the x-dev-user header instead of JWT auth (local dev only)
DEV_AUTH=0
